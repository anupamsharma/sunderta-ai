APP_ENV=development
API_PORT=8010
FRONTEND_PORT=3000

MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=sunderta_dental
REDIS_URL=redis://redis:6379/0

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://india-west-az-ai.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-12-01-preview

UPLOAD_ROOT=./data/uploads-3d
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100
MAX_VIDEO_DURATION_SECONDS=30

# Monocular-depth POC settings
DEPTH_MODEL=depth-anything/Depth-Anything-V2-Small-hf
MAX_FRAMES=8
POINT_STRIDE=4
VOXEL_SIZE=0.01

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000
RQ_QUEUE_NAME=dental_3d_analysis
JOB_TIMEOUT_SECONDS=1200
MAX_JOB_RETRIES=2

ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_DAYS=30
COOKIE_SECURE=
