# Public HTTPS via sslip.io (resolves to the VM public IP).
# Phone browsers often force HTTPS — use the https://sslip.io URL.
8.234.68.196.sslip.io {
	encode gzip
	reverse_proxy frontend:3000
}

# Still allow plain HTTP on the raw IP (desktop-friendly).
http://8.234.68.196 {
	encode gzip
	reverse_proxy frontend:3000
}

# Local / health convenience
:80 {
	encode gzip
	reverse_proxy frontend:3000
}
